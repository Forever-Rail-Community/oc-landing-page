---
// What's inside: the three parts of the Operations Center, each with a picture of it.
import Feature from './Feature.astro'
import MapShot from './MapShot.astro'
import BoardShot from './BoardShot.astro'
import RoadmapShot from './RoadmapShot.astro'
---

<section class="part" id="inside" aria-labelledby="inside-title">
  <div class="wrap">
    <div class="intro">
      <h2 id="inside-title">Everything your railroad runs on, all in one place</h2>
      <p>Live trains, server status, and a dispatcher's board that talks to the game, right in your browser. Sign in with Discord and you're on duty.</p>
    </div>

    <Feature title="Watch it run" points={['A live map that refreshes every few seconds', 'Server status at a glance', 'Where every train has been']}>
      See the entire railroad at a glance, with every train exactly where it is right now. Know which servers are up before you even launch the game.
      <MapShot slot="shot" />
    </Feature>

    <Feature title="Dispatch it together" flip points={['Live signals, switches, and trains', 'A desk for every dispatcher', 'Clean handoffs with turnover notes']}>
      A real CTC board in your browser, wired straight to the game. Clear signals, line switches, and split the line into desks so a whole crew of dispatchers can run it side by side.
      <BoardShot slot="shot" />
    </Feature>

    <Feature title="Shape what comes next" points={['Feature requests and bug reports', 'A roadmap you can follow', 'A help center for getting started']}>
      Got an idea? Request it. Found a bug? Report it. Then follow it across the roadmap as it gets built, with guides and release notes right alongside.
      <RoadmapShot slot="shot" />
    </Feature>
  </div>
</section>
