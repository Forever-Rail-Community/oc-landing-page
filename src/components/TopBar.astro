---
// The bar along the top: the logo, the sections, and the way in. Turns solid once the page scrolls past the top.
import { DISCORD_URL } from '../data/site'
---

<header class="top">
  <img src="/logo.png" width="117" height="40" alt="Forever Rail" />
  <span class="name">Operations Center</span>
  <nav aria-label="On this page">
    <a href="#inside">What's inside</a>
    <a href="#next">What's next</a>
    <a class="button primary" href={DISCORD_URL}>Join the Discord</a>
  </nav>
  <i class="progress" aria-hidden="true"></i>
</header>

<script>
  // Solid once scrolled. (The line along its foot is filled by src/scripts/motion.ts.)
  const bar = document.querySelector<HTMLElement>('.top')!
  const mark = () => bar.classList.toggle('scrolled', scrollY > 8)
  addEventListener('scroll', mark, { passive: true })
  mark()
</script>

<style>
  .top {
    position: fixed; inset: 0 0 auto; z-index: 3; display: flex; align-items: center; gap: 16px;
    padding: 20px clamp(20px, 3vw, 40px); border-bottom: 1px solid transparent; transition: background 200ms, border-color 200ms;
  }
  .progress {
    position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--orange); transform-origin: left; transform: scaleX(0);
    opacity: 0; transition: opacity 200ms; box-shadow: 0 0 8px rgba(252, 131, 0, 0.7);
  }
  .top.scrolled .progress { opacity: 1; }
  .top.scrolled { background: rgba(15, 17, 21, 0.86); backdrop-filter: blur(8px); border-color: var(--line); padding-block: 12px; }
  img { display: block; height: 40px; width: auto; }
  .name { padding-left: 16px; border-left: 1px solid var(--line); font-family: Jost, sans-serif; font-weight: 500; font-size: 17px; color: var(--faint); }
  nav { margin-left: auto; display: flex; align-items: center; gap: 22px; }
  nav a:not(.button) { color: var(--muted); text-decoration: none; font-weight: 500; font-size: 15px; }
  nav a:not(.button):hover { color: var(--text); }
  .button { min-height: 38px; }
  @media (max-width: 760px), (max-height: 600px) {
    .top { padding: 14px 20px; }
    img { height: 34px; }
    .name { font-size: 15px; padding-left: 12px; }
  }
  @media (max-width: 760px) {
    nav a:not(.button), .name { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .top { transition: none; } }
</style>
