---
// The "Watch it run" picture: the yard and junction from the rails drawing, over made-up terrain and a river
// (public/map.webp, drawn by tools/draw-map.py), with trains running on it (src/scripts/trains.ts) and signals and
// switches answering to them (src/scripts/wayside.ts). Everything is in the drawing's 1440 x 900 coordinates; the view
// is its bottom left, where the most track is.
---

<div class="shot">
  <svg data-map data-train-scale="1.4" data-cycle="54" viewBox="0 310 960 590" role="img" aria-label="The live map: the rails over the hills and a river, with trains running along them in orange, and signals and switches changing as they pass">
    <image href="/map.webp" x="0" y="310" width="960" height="590" />
    <!-- Places, all made up. -->
    <g class="places">
      <text x="182" y="602">MILL GAP</text>
      <text x="905" y="392">HOLLIS</text>
      <text class="water" x="858" y="790" transform="rotate(64 858 790)">Cold Creek</text>
    </g>
    <!-- Tracks, traced off the drawing's rails (tools/trace-rail.py): the main line, a track out of the yard, and the
         branch. Each train has its own, so they never meet. -->
    <g class="tracks">
      <path id="main-line" d="M1000.0 428.0 L653.3 554.6 L644.1 558.5 L627.0 564.1 L577.3 582.4 L568.7 585.0 L553.8 590.9 L533.0 598.0 L524.6 601.4 L300.0 683.1 L261.6 697.5 L239.8 707.6 L216.1 720.6 L203.5 728.6 L185.5 741.3 L163.7 758.9 L151.2 770.4 L135.2 786.9 L118.9 805.9 L97.9 835.1 L85.1 858.8 L66.0 898.5" />
      <path id="yard-lead" d="M1000.0 421.5 L705.8 528.3 L693.4 532.2 L676.7 538.9 L599.8 567.5 L513.2 598.5 L499.3 604.1 L479.4 610.9 L465.0 615.2 L435.5 620.9 L402.6 623.4 L382.0 627.2 L360.8 633.1 L335.5 642.5 L331.2 645.0" />
      <path id="branch" d="M1000.0 435.5 L938.1 458.5 L928.6 461.5 L710.6 540.9 L679.4 551.8 L668.3 556.3 L547.1 600.6 L535.3 606.0 L503.5 623.0 L492.5 629.9 L482.2 637.9 L472.0 647.5 L460.9 660.3 L455.4 667.5 L447.8 679.2 L440.5 692.3 L434.6 705.0 L430.0 717.2 L426.6 728.7 L423.1 744.3 L421.5 757.2 L421.1 774.2 L422.0 785.1 L424.2 797.0 L431.3 819.9 L461.9 898.1" />
    </g>
    <!-- Switches where the rails branch (tools/find-switches.py), and signals: their track, where along the run (in
         the direction of travel), and which side. Each train's last signal before its station holds it there. -->
    <g class="switches" data-points="866,440 933,461 811,462 800,471 741,483 769,490 735,509 702,529 670,554 653,556 591,571 577,581 526,600 509,601 531,607 376,612 460,617 427,622 393,624 338,626 144,736 131,767 120,791 428,813 113,826 101,828"></g>
    <g class="signal" data-track="main-line" data-at="0.18" data-side="below"></g>
    <g class="signal" data-track="main-line" data-at="0.612" data-side="below"></g>
    <g class="signal" data-track="main-line" data-at="0.8" data-side="below"></g>
    <g class="signal" data-track="yard-lead" data-at="0.2" data-side="above"></g>
    <g class="signal" data-track="yard-lead" data-at="0.518" data-side="above"></g>
    <g class="signal" data-track="yard-lead" data-at="0.8" data-side="above"></g>
    <g class="signal" data-track="branch" data-at="0.515" data-side="below"></g>
    <g class="signal" data-track="branch" data-at="0.72" data-side="below"></g>
    <g class="signal" data-track="branch" data-at="0.86" data-side="below"></g>
    <!-- Trains: their track, symbol, cars behind the locomotive, speed (drawing units a second), stations as fractions
         of the run, and how long they wait there; all three repeat every 54 seconds (data-cycle), set apart by their offsets.
         The yard job runs the other way, out of the yard, with its symbol underneath. -->
    <g class="train" data-track="main-line" data-symbol="WB 214" data-cars="5" data-speed="46" data-stops="0.6" data-dwell="5"></g>
    <g class="train" data-track="yard-lead" data-symbol="EB 12" data-cars="4" data-speed="38" data-stops="0.5" data-dwell="4" data-reverse="true" data-label="below" data-offset="12"></g>
    <g class="train" data-track="branch" data-symbol="L 31" data-cars="3" data-speed="30" data-stops="0.5" data-dwell="6" data-offset="-20"></g>
  </svg>
  <span class="status"><b></b>All servers up</span>
</div>

<script>
  import { startTrains } from '../scripts/trains'
  document.querySelectorAll<SVGSVGElement>('svg[data-map]').forEach(startTrains)
</script>

<style>
  .shot { position: relative; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: #0B0D10; aspect-ratio: 960 / 590; }
  svg { display: block; width: 100%; height: 100%; }
  .places text { font: 600 15px 'Barlow Condensed', sans-serif; letter-spacing: 0.18em; fill: #8B93A1; paint-order: stroke; stroke: #181A1E; stroke-width: 5px; }
  .places .water { font: italic 500 14px Barlow, sans-serif; letter-spacing: 0.04em; fill: #4E7590; }
  .status {
    position: absolute; left: 16px; top: 16px; display: flex; align-items: center; gap: 8px; padding: 6px 10px; border-radius: 8px;
    font-size: 13px; background: rgba(15, 17, 21, 0.88); border: 1px solid var(--line); color: var(--muted);
  }
  .status b { width: 8px; height: 8px; border-radius: 50%; background: #22C55E; }
</style>
