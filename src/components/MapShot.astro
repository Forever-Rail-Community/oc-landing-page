---
// The "Watch it run" picture: the yard and junction from the rails drawing, with trains running on it
// (src/scripts/trains.ts). Each train has a track of its own, traced over the drawing in its 1440 x 900 coordinates;
// the view is its bottom left, where the most track is.
---

<div class="shot">
  <svg data-map viewBox="0 310 960 590" role="img" aria-label="The live map: the rails, with trains running along them in orange">
    <image href="/track.webp" x="0" y="0" width="1440" height="900" />
    <!-- Tracks: the main line, the upper track beside it, and the branch. -->
    <path id="main-line" d="M1000 428 L920 457 L840 486 L760 515 L680 544 L600 573 L520 595 L480 610 L398 640 L322 660 L255 700 L179 760 L115 820 L74 880 L64 900" />
    <path id="upper-track" d="M1000 385 L920 414 L840 447 L760 478 L680 506 L620 527" />
    <path id="branch" d="M479 640 L460 660 L446 680 L436 700 L428 720 L423 740 L421 770 L424 800 L431 820 L439 840 L446 860 L454 880 L462 900" />
    <!-- Trains: their track, length of cars, speed (drawing units a second), stations as fractions of the run, and
         how long they wait there. -->
    <g class="train" data-track="main-line" data-cars="70" data-speed="48" data-stops="0.42" data-dwell="5"><path /><circle r="5" /></g>
    <g class="train" data-track="upper-track" data-cars="54" data-speed="40" data-stops="0.55" data-dwell="4" data-reverse="true" data-offset="9"><path /><circle r="5" /></g>
    <g class="train" data-track="branch" data-cars="44" data-speed="30" data-stops="0.5" data-dwell="6" data-offset="4"><path /><circle r="5" /></g>
  </svg>
  <span class="status"><b></b>All servers up</span>
</div>

<script>
  import { startTrains } from '../scripts/trains'
  document.querySelectorAll<SVGSVGElement>('svg[data-map]').forEach(startTrains)
</script>

<style>
  .shot { position: relative; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: #0B0D10; aspect-ratio: 960 / 590; }
  svg { display: block; width: 100%; height: 100%; }
  svg > path { fill: none; }
  .train path { fill: none; stroke: var(--orange); stroke-width: 9; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 6px rgba(252, 131, 0, 0.55)); }
  .train circle { fill: #FFF3D6; filter: drop-shadow(0 0 6px #FFD9A0); }
  .status {
    position: absolute; left: 16px; top: 16px; display: flex; align-items: center; gap: 8px; padding: 6px 10px; border-radius: 8px;
    font-size: 13px; background: rgba(15, 17, 21, 0.88); border: 1px solid var(--line); color: var(--muted);
  }
  .status b { width: 8px; height: 8px; border-radius: 50%; background: #22C55E; }
</style>
