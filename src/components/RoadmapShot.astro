---
// The "Shape what comes next" picture: roadmap items moving from planned to complete. The names are blurred bars, so
// the picture shows how the roadmap works without saying what's on it.
const ITEMS = [
  { width: 62, stage: 'Planned' },
  { width: 48, stage: 'Up next' },
  { width: 70, stage: 'In progress', now: true },
  { width: 54, stage: 'Complete' }
]
---

<div class="shot" role="img" aria-label="The roadmap: items moving from planned, through up next and in progress, to complete">
  {ITEMS.map((item) => <div><i style={`width: ${item.width}%`}></i><span class:list={{ now: item.now }}>{item.stage}</span></div>)}
</div>

<style>
  .shot { border: 1px solid var(--line); border-radius: 14px; background: var(--surface); padding: 22px; display: grid; align-content: center; gap: 10px; min-height: 280px; }
  div div { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px; border: 1px solid var(--line); border-radius: 10px; background: var(--ground); }
  i { height: 12px; border-radius: 6px; background: linear-gradient(90deg, #3A3F49, #2B2F37); filter: blur(0.6px); }
  span { font-size: 13px; padding: 3px 9px; border-radius: 999px; border: 1px solid var(--line); color: var(--faint); white-space: nowrap; }
  span.now { color: var(--orange); border-color: rgba(252, 131, 0, 0.45); }
</style>
