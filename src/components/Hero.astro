---
// The opening: the jigsaw (src/scripts/puzzle.ts) with the message in its gap.
import { DISCORD_URL } from '../data/site'
---

<section class="hero">
  <svg class="board" aria-hidden="true">
    <defs>
      <pattern id="rails" patternUnits="userSpaceOnUse" x="0" y="0">
        <image preserveAspectRatio="xMidYMid slice"></image>
      </pattern>
    </defs>
    <g class="pieces"></g>
    <rect class="dim" fill="#0F1115" fill-opacity="0.3"></rect>
    <!-- A train's lights running down the main line once the puzzle is together (wide screens; the drawing's own
         coordinates). pathLength makes the dashes a share of the run. -->
    <g class="streak">
      <path pathLength="1000" class="cars" d="M1440 262 L1400 285 L1320 318 L1240 348 L1160 377 L1080 407 L1000 435 L600 573 L480 610 L398 640 L322 660 L255 700 L179 760 L115 820 L74 880 L64 900" />
      <path pathLength="1000" class="light" d="M1440 262 L1400 285 L1320 318 L1240 348 L1160 377 L1080 407 L1000 435 L600 573 L480 610 L398 640 L322 660 L255 700 L179 760 L115 820 L74 880 L64 900" />
    </g>
    <path class="gap"></path>
    <g class="loose"><path class="seam" fill="url(#rails)" stroke-opacity="0.25"></path></g>
  </svg>
  <div class="message">
    <h1>The last piece is on its way.</h1>
    <p class="lede">Watch the railroad live, dispatch it together, and help shape what comes next. The Forever Rail Operations Center opens here soon.</p>
    <div class="buttons">
      <a class="button primary" href={DISCORD_URL}>Join the Discord</a>
      <a class="button" href="#inside">See what's inside</a>
    </div>
  </div>
</section>

<script>
  import { startPuzzle } from '../scripts/puzzle'
  startPuzzle(document.querySelector<HTMLElement>('.hero')!)
</script>

<style>
  .hero { position: relative; height: 100svh; min-height: 560px; display: grid; place-items: center; overflow: hidden; }
  .board { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* The pieces are drawn by the script, so these reach them with :global. */
  .board :global(.seam) {
    stroke: #FFFFFF; stroke-opacity: 0.12; stroke-width: 1.4;
    transform-box: fill-box; transform-origin: center;
    transition: transform 900ms cubic-bezier(.2, .8, .2, 1), opacity 500ms ease;
  }
  .board.scattered .pieces :global(.seam) { transform: var(--from); opacity: 0; }
  .board .gap {
    fill: var(--ground); stroke: var(--orange); stroke-opacity: 0.8; stroke-width: 2; stroke-dasharray: 8 7;
    transition: opacity 500ms ease var(--assembled-ms);
  }
  .board.scattered .gap { opacity: 0; }
  .board .loose {
    transform-box: fill-box; transform-origin: center;
    transition: transform 1400ms cubic-bezier(.2, .8, .2, 1) calc(var(--assembled-ms) + 300ms);
    filter: drop-shadow(0 24px 30px rgba(0, 0, 0, 0.6));
  }
  .board.settled .loose { transform: var(--rest); }

  /* The train's lights: its cars a stretch of orange with the headlight at the front, running the main line, then a
     pause before the next. */
  .streak { display: none; pointer-events: none; }
  .board.settled:not(.column) .streak { display: block; }
  .streak path { fill: none; stroke-linecap: round; }
  .streak .cars { stroke: var(--orange); stroke-width: 7; stroke-dasharray: 70 2000; stroke-dashoffset: 70; filter: drop-shadow(0 0 10px rgba(252, 131, 0, 0.8)); }
  .streak .light { stroke: #FFF3D6; stroke-width: 9; stroke-dasharray: 2 2000; stroke-dashoffset: 2; filter: drop-shadow(0 0 12px #FFD9A0); }
  @media (prefers-reduced-motion: no-preference) {
    .board.settled .streak .cars { animation: run-cars 16s linear infinite; animation-delay: calc(var(--assembled-ms) + 1800ms); }
    .board.settled .streak .light { animation: run-light 16s linear infinite; animation-delay: calc(var(--assembled-ms) + 1800ms); }
  }
  @media (prefers-reduced-motion: reduce) { .streak { display: none !important; } }
  @keyframes run-cars { from { stroke-dashoffset: 70; } 55%, to { stroke-dashoffset: -1000; } }
  @keyframes run-light { from { stroke-dashoffset: 2; } 55%, to { stroke-dashoffset: -1068; } } /* kept at the front of the cars */

  /* The gap is 480 of the drawing's 1440 x 900, scaled to cover the opening, so max(33.3vw, 53.3svh) wide. */
  .message {
    position: relative; width: min(440px, max(30vw, 48svh), calc(100% - 48px)); margin: 24px;
    display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center;
  }
  h1 { font-size: 36px; line-height: 1.08; }
  .lede { margin: 0; font-size: 16px; line-height: 1.5; color: var(--muted); text-wrap: pretty; }
  /* Hidden until the puzzle starts (src/scripts/puzzle.ts sets when), so it never shows over the loose piece. */
  :global(.js) .hero:not(.started) .message { opacity: 0; }
  .hero.started .message { opacity: 1; animation: arrive 700ms ease both; animation-delay: var(--message-delay); }
  @keyframes arrive { from { opacity: 0; translate: 0 8px; } }
  @media (max-width: 760px), (max-height: 600px) {
    .message { width: min(400px, calc(100% - 56px)); }
    h1 { font-size: 30px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .board :global(.seam), .board .gap, .board .loose { transition: none; }
    .hero.started .message { animation: none; }
  }
</style>
