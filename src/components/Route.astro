---
// Coming down the line: the pieces as stations on a route map (src/data/route.ts). When it scrolls into view, the
// line lights up to where things stand and each station lights in turn.
import { STAGE_LABEL, STATIONS, progress } from '../data/route'
---

<section class="part next" id="next" aria-labelledby="next-title">
  <div class="wrap">
    <div class="intro">
      <h2 id="next-title">Coming down the line</h2>
      <p>Most of the pieces are already in place. Here's where the rest stand. We're keeping a few surprises for opening day.</p>
    </div>
    <ol class="route" style={`--progress: ${progress(STATIONS)}`}>
      {STATIONS.map((s, i) => (
        <li class={s.stage} style={`--i: ${i}`}>
          <i class="stop" aria-hidden="true"></i>
          <span class="when">{STAGE_LABEL[s.stage]}</span>
          <h3>{s.name}</h3>
          <p>{s.blurb}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  // Lights the route once it's well into view (it's lit from the start with reduced motion, by the styles).
  const route = document.querySelector<HTMLElement>('.route')!
  new IntersectionObserver((entries, watcher) => {
    if (!entries.some((e) => e.isIntersecting)) return
    route.classList.add('lit')
    watcher.disconnect()
  }, { threshold: 0.5 }).observe(route)
</script>

<style>
  .next { background: var(--surface); border-block: 1px solid var(--line); }
  .route { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); position: relative; --step: 400ms; }
  /* The line between the first and last stations, and the lit part of it on top. */
  .route::before, .route::after { content: ''; position: absolute; left: 10%; right: 10%; top: 13px; height: 4px; border-radius: 2px; background: var(--line); }
  .route::after { background: var(--orange); transform-origin: left; transform: scaleX(0); transition: transform 1600ms cubic-bezier(.4, 0, .2, 1); }
  .route.lit::after { transform: scaleX(var(--progress)); }
  li { position: relative; display: grid; justify-items: center; align-content: start; gap: 6px; padding: 0 10px; text-align: center; }
  .stop { width: 30px; height: 30px; border-radius: 50%; border: 4px solid var(--line); background: var(--surface); box-sizing: border-box; margin-bottom: 12px; position: relative; z-index: 1; transition: border-color 300ms, background 300ms, box-shadow 600ms; transition-delay: calc(var(--i) * var(--step)); }
  h3 { font-size: 19px; }
  li p { margin: 0; font-size: 15px; line-height: 1.45; color: var(--muted); max-width: 22ch; }
  .when { font-size: 13px; font-weight: 600; color: var(--faint); transition: color 300ms calc(var(--i) * var(--step)); }
  .lit .in-place .stop { border-color: var(--orange); background: var(--orange); box-shadow: 0 0 0 6px rgba(252, 131, 0, 0.18); }
  .lit :is(.testing, .building) .stop { border-color: var(--orange); background: linear-gradient(90deg, var(--orange) 50%, var(--surface) 50%); }
  .lit :is(.in-place, .testing, .building) .when { color: var(--orange); }
  /* What's being worked on now gently pulses once lit. */
  @media (prefers-reduced-motion: no-preference) {
    .lit :is(.testing, .building) .stop { animation: working 2.4s ease-in-out infinite; animation-delay: calc(var(--i) * var(--step) + 600ms); }
  }
  @keyframes working { 50% { box-shadow: 0 0 0 8px rgba(252, 131, 0, 0.16); } }
  @media (prefers-reduced-motion: reduce) {
    .route { --step: 0ms; }
    .route::after { transition: none; }
  }
  @media (max-width: 760px) {
    .route { grid-template-columns: 1fr; gap: 26px; }
    .route::before, .route::after { left: 13px; right: auto; top: 10px; bottom: 10px; width: 4px; height: auto; }
    .route::after { transform-origin: top; transform: scaleY(0); }
    .route.lit::after { transform: scaleY(var(--progress)); }
    li { grid-template-columns: 30px 1fr; justify-items: start; column-gap: 16px; padding: 0; text-align: left; }
    .stop { grid-row: span 3; margin: 0; }
  }
</style>
