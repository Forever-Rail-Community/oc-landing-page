---
// The page's head (title, sharing previews, icons) and the styles every part shares.
import '../styles/global.css'
import { DESCRIPTION, TITLE } from '../data/site'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta name="theme-color" content="#0F1115" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://oc.foreverrail.com/" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={`The last piece is on its way. ${DESCRIPTION}`} />
    <meta property="og:image" content="https://oc.foreverrail.com/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Marks that scripts run, so anything they reveal is only hidden when they will. -->
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <slot />
  </body>
</html>
